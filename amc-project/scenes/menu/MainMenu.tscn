[node name="Desc" type="Label" parent="GuideDialog/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.96, 1)
theme_override_font_sizes/font_size = 13
text = "• Di chuyển: Phím W A S D hoặc 4 phím Mũi tên.
• Tấn công: Vũ khí tự động quét mục tiêu gần nhất và khai hỏa liên tục.
• Kỹ năng [Space]: Lướt chiến thuật, miễn nhiễm sát thương và tăng 50% Tốc đánh trong 3s.
• Phúc lợi & Lõi nâng cấp: Bốc ngẫu nhiên sau Wave 1, 3, 5 cường hóa sức mạnh đột phá.
• Cửa hàng 6 Ô: Mua sắm trang bị giữa mỗi đợt, bán đồ hoàn lại 50% vàng.
• Wave 6 (Chuẩn bị): Mật độ quái đông, lượng máu thấp, nhân đôi lượng vàng rơi.
• Wave 7 (Trùm cuối): Đối đầu Chiến Hạm Hủy Diệt với 2 pha chiến đấu nảy lửa!"
autowrap_mode = 2

[node name="CloseGuideButton" type="Button" parent="GuideDialog/Margin/VBox"]
